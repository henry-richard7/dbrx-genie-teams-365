# Microsoft App Registration Details
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=your_tenant_id_here
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=your_app_client_id_here
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=your_app_client_secret_here

# Server Settings
PORT=3978
DEBUG=true

# Databricks Genie Settings
# Use DATABRICKS_HOST for single-workspace mode. 
# Alternatively, use DATABRICKS_ACCOUNT_HOST and DATABRICKS_ACCOUNT_ID for account-level auth.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_ACCOUNT_HOST=https://accounts.cloud.databricks.com
# DATABRICKS_ACCOUNT_ID=your_account_id_here
ENABLE_CHARTS=active
GET_AI_INSIGHTS=true

USE_CONTEXT=false
STORAGE=s3 # If USE_CONTEXT is true need to set this. Can be 's3', 'cosmos', or 'blob'.
TOKEN_ENCRYPTION_KEY=your_generated_fernet_key_here

# If STORAGE=s3
S3_BUCKET_NAME=your_s3_bucket
S3_ENDPOINT_URL=http://localhost:9000 # Omit for real AWS S3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_KEY_PREFIX=agent-state/
S3_DISABLE_SIGNING=false # Set to true to apply path-style addressing and non-chunked signing (e.g. for MinIO / custom S3)

# Azure Cosmos DB Storage Settings# If STORAGE=cosmos
COSMOS_DB_ENDPOINT=https://your-cosmos-db-account.documents.azure.com:443/
COSMOS_DB_KEY=your-cosmos-db-primary-or-secondary-key # Omit to use Azure Managed Identity
COSMOS_DB_DATABASE=BotStateDb
COSMOS_DB_CONTAINER=BotStateContainer
COSMOS_DB_DISABLE_SSL=false # Set to true when using local Cosmos DB Emulator

# If STORAGE=blob
AZURE_BLOB_CONTAINER=bot-state
# Use "UseDevelopmentStorage=true" for local Azurite Emulator
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=... # Omit to use Azure Managed Identity
AZURE_BLOB_URL=https://your-account.blob.core.windows.net

# Global Databricks Credentials M2M (if not using Entra ID groups)
DATABRICKS_TOKEN=your_personal_access_token_here
DATABRICKS_CLIENT_ID=your_m2m_oauth_client_id_here
DATABRICKS_CLIENT_SECRET=your_m2m_oauth_client_secret_here

# User-Interactive Custom OAuth U2M (if prompting users to login)
DATABRICKS_OAUTH_CLIENT_ID=your_custom_oauth_client_id_here
DATABRICKS_OAUTH_CLIENT_SECRET=your_custom_oauth_client_secret_here
OAUTH_REDIRECT_URI=https://your-bot-domain.com/api/oauth/callback

# OpenAI-Compatible LLM Settings (e.g., Databricks, OpenAI, vLLM, Ollama)
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_api_key_here

# OrcaRouter Settings (OpenAI-Compatible Multi-Model AI Gateway & Routing)
# Referral / Get an API Key: https://www.orcarouter.ai/ref/ref_0a1e6a219c956b889037
# To route through OrcaRouter, configure:
# OPENAI_BASE_URL=https://api.orcarouter.ai/v1
# OPENAI_MODEL_NAME=orcarouter/auto
# OPENAI_API_KEY=your_orcarouter_api_key

# Optional: Database Connection String (Defaults to local SQLite)
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
